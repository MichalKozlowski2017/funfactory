  {
   "name": "lusia-witaj",
   "text": "Cześć! Jestem Lusia, a to mój przyjaciel Bazyl. Wybierz domek i pobawmy się razem!",
   "voice": "voices/alt"
  },
  {
   "name": "lusia-cienie",
